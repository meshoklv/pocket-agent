<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Просим у системы повышенный лимит памяти под веса модели.
	     Файл модели весит 2,6 ГБ, и без этого права на видеочип он не поднимется:
	     система убьёт приложение на середине загрузки. Ради этого право и заводили.

	     ⚠️ ГЛАВНОЕ, ЧТО НЕЛЬЗЯ ЗАБЫТЬ: Apple лишнюю память НЕ ГАРАНТИРУЕТ.
	     Дословно в её документации — повышенный лимит доступен лишь на части
	     моделей устройств, приложение обязано вести себя правильно, если
	     дополнительной памяти не дали, а сколько её на самом деле — спрашивать
	     функцией os_proc_available_memory.
	     Это право — просьба, а не обещание. Поэтому рантайм-проверка MemoryGate
	     остаётся обязательной, и выкидывать её «раз права теперь есть» НЕЛЬЗЯ:
	     ровно она превращает молчаливый отстрел приложения системой в честное
	     «не хватает памяти, закройте другие приложения». -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>

	<!-- Расширенное адресное пространство: веса модели отображаются в память
	     через mmap, и без него такому файлу просто некуда лечь — упрёмся
	     в границу адресного пространства раньше, чем в саму память. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>

	<!-- ⚠️ ЧЕГО ЗДЕСЬ НЕТ НАМЕРЕННО (проверено 09.08.2026 по кабинету Apple).
	     В кабинете у приложения включено восемь возможностей, и профиль подписи
	     разрешает их все. Но право, вписанное СЮДА, приложение реально ПРОСИТ
	     у системы, и каждое лишнее просимое право — лишний повод для вопросов
	     при проверке в App Store. Поэтому берём только те два, без которых
	     модель не работает.

	     Не вписаны сознательно:
	       • background-tasks.continued-processing.gpu и .inference — сами по себе
	         они не дают ничего: нужна отдельная работа в коде (задача
	         BGContinuedProcessingTask, которая показывает человеку ход дела
	         и которую система вправе оборвать), а её у нас нет. Вдобавок
	         «.inference» — это про нейромодуль, а мы считаем на видеочипе.
	         Появится фоновый счёт — тогда и вписывать.
	       • kernel.increased-debugging-memory-limit — прибавка памяти действует,
	         только когда к приложению подключён отладчик. Сборка на телефон
	         ставится и запускается с домашнего экрана, без отладчика, — смысла нет.
	       • side-button-access.allow и networking.multipath — к нашей задаче
	         отношения не имеют вовсе. -->
</dict>
</plist>
